{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bishudeck",
  "version": "0.1.4",
  "identifier": "com.tominagateam.bishudeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bishudeck",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": ["'self'", "'unsafe-inline'", "https:", "slides:", "http://slides.localhost"],
        "img-src": ["'self'", "data:", "blob:", "https:"],
        "font-src": ["'self'", "data:", "https:", "slides:", "http://slides.localhost"],
        "media-src": ["'self'", "data:", "blob:", "https:"],
        "frame-src": ["'self'", "slides:", "http://slides.localhost", "blob:"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"]
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": ["'self'", "'unsafe-inline'", "'unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'", "https:", "slides:", "http://slides.localhost"],
        "img-src": ["'self'", "data:", "blob:", "https:"],
        "font-src": ["'self'", "data:", "https:", "slides:", "http://slides.localhost"],
        "media-src": ["'self'", "data:", "blob:", "https:"],
        "frame-src": ["'self'", "slides:", "http://slides.localhost", "blob:"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "ws://localhost:1420",
          "http://localhost:1420"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
